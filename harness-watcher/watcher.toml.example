# harness-watcher configuration
# Скопируй в ~/.config/harness-watcher/config.toml и заполни своими значениями.

[remote]
# Удалённая рабочая машина — подключение с локального executor-хоста.
# Не коммитьте реальные host aliases, логины и ключи в командный шаблон.
ssh_host = "executor@example.internal"
ssh_port = 22
ssh_key = "~/.ssh/team_exec"

# Secure default: fail if the remote host key is unknown or has changed.
strict_host_key_checking = true

# Optional dedicated known_hosts file. If omitted/empty, OpenSSH uses its defaults.
# The configured file must already exist; obtain and verify its host key out of band.
user_known_hosts_file = ""

# Setting strict_host_key_checking=false is a high-risk, test-only opt-out.
# Do not use it for shared or production execution.

# Путь к удалённому репозиторию с docs/harness/exec-requests/.
# Получите реальное значение у владельца окружения — не угадывайте deploy path.
remote_repo_root = "/srv/team/service"

[local]
# Существующая локальная копия. Команды могут менять её; не используйте важную
# рабочую папку. TOML не подтверждает владение: используйте sync=none.
# Для pull создайте управляемое зеркало через watcher.py add.
local_repo_root = "/work/harness-mirrors/service"

[poller]
# Как часто опрашивать удалённую очередь (секунды)
poll_interval_seconds = 3

# Максимальное время одной exec-сессии (секунды)
default_timeout_seconds = 600

# Сколько последних строк stdout/stderr включать в отчёт
stdout_max_chars = 8000
stderr_max_chars = 4000

[executor]
# Внешний TOML-каталог не очищается. Его snapshot поддерживает владелец.
# Managed-профиль, созданный через add, поддерживает безопасный pull отдельно.
sync_before_exec = false

# true запрещён; request push/both также отклоняется.
sync_after_exec = false

# Bash-команды, которые выполняются ПЕРЕД каждой командой в request.
# Используй для активации заранее подготовленного runtime/PATH без секретов.
# Hook проходит фильтр команд, но его содержимое не изолируется средствами ОС.
#
# Примеры:
#   pre_exec_hook = "source /work/harness-envs/service/bin/activate"
#   pre_exec_hook = "export PATH=/opt/team-tools/bin:$PATH"
#   pre_exec_hook = "source /work/harness-envs/service/bin/activate && export PYTHONPATH=src"
#
# По умолчанию пусто — никаких префиксов перед командой.
pre_exec_hook = ""

# Фильтр явных сетевых команд, удаления и чтения секретов включён всегда.
# Это не ОС-песочница: действия внутри тестов/Makefile не блокируются гарантированно.
# Legacy-имя поля: дополнительные секретные пути исключаются из sync/fingerprint,
# но это не запрет их чтения средствами ОС.
sandbox_secret_roots = []

[paths]
audit_log_path = "~/.config/harness-watcher/audit.log"
state_path = "~/.config/harness-watcher/state.json"

[filter]
# Фильтрация шума из stdout перед записью в exec-report (тот что читает агент).
# Не влияет на verbose окно (-v) — там полный поток.
# stderr и failed commands НЕ фильтруются — полный контекст важен для отладки.

# Включить фильтр (default: true)
enabled = true

# Убирать ANSI escape codes (цвета терминала) — нужно почти всегда
strip_ansi = true

# Применять встроенный список паттернов:
# - известный шум managed-workstation pre-exec hooks
# - uv progress (Downloading, Building, Installed)
# - uv VIRTUAL_ENV warnings
strip_defaults = true

# Дополнительные regex-паттерны для локальной специфики проекта.
# Не добавляйте сюда имена реальных сервисов в командном шаблоне.
extra_patterns = [
    # "^MYAPP-DEBUG:",
    # "fontTools.*INFO",
]

[rsync]
# Legacy-имя секции сохранено для совместимости. Текущий poller применяет эти
# exclude-паттерны к tar-sync. Они только дополняют встроенные обязательные
# исключения (.git, .env*, *.env, credential stores, ключи и сертификаты).
# Даже exclude = [] не передаёт такие файлы; .env.example тоже не переносится.
# Включённые symlink, hardlink и специальные файлы блокируют sync до чтения;
# для них подготовьте обычные независимые файлы без секретов.
# sandbox_secret_roots внутри зеркала также исключаются из sync и fingerprints.
# Если старое зеркало уже содержит защищённый файл или .git, pull не удаляет
# его: используйте новое watcher-managed зеркало. Секреты не удаляются автоматически.
# Источник должен оставаться неизменным на время sync: metadata preflight и
# tar/rsync не являются одной атомарной операцией. Проверка касается передачи,
# а не всех последующих действий запущенной программы.
exclude = [
    ".git",
    "__pycache__",
    ".venv",
    "venv",
    "node_modules",
    ".pytest_cache",
    ".ruff_cache",
    "*.pyc",
    ".DS_Store",
    "dist",
    "build",
    "*.egg-info",
    ".env",
    ".env.local",
    ".env.production",
]
